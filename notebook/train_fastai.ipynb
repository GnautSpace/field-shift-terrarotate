import pandas as pd
from fastai.tabular.all import *

print("Ingesting 2,200 empirical agricultural field trials...")
DATA_URL = "https://raw.githubusercontent.com/Gladiator07/Harvestify/master/Data-processed/crop_recommendation.csv"
df = pd.read_csv(DATA_URL)

cont_names = ["N", "P", "K", "temperature", "humidity", "ph", "rainfall"]
splits = RandomSplitter(valid_pct=0.2, seed=42)(range_of(df))

dls = TabularDataLoaders.from_df(
    df,
    path=".",
    y_names="label",
    cont_names=cont_names,
    procs=[Normalize],
    splits=splits,
    bs=64
)

print("Training FastAI Tabular Neural Network Classifier...")
learn = tabular_learner(dls, layers=[128, 64], metrics=accuracy)
learn.fit_one_cycle(8, lr_max=1e-2)

learn.export("model/crop_classifier.pkl")
print("\n[SUCCESS] Production model saved as crop_classifier.pkl")