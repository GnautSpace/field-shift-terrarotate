import requests
import pandas as pd
import time
from fastai.tabular.all import *


print(" Step 1: Querying OpenStreetMap API to dynamically discover real farmland coordinates...")


GEO_API_URL = "https://nominatim.openstreetmap.org/search"
geo_params = {
    "q": "agricultural research station",
    "format": "json",
    "limit": 8,
    "addressdetails": 1
}
headers = {"User-Agent": "NASA-SpaceApps-Challenge-Dynamic-Pipeline/1.0"}

geo_response = requests.get(GEO_API_URL, params=geo_params, headers=headers).json()

discovered_farms = []
for item in geo_response:
    discovered_farms.append({
        "name": item.get("display_name", "Global Farm Site")[:35],
        "lat": round(float(item["lat"]), 2),
        "lon": round(float(item["lon"]), 2)
    })

print(f"Discovered {len(discovered_farms)} real farm sites dynamically from the API:")
for f in discovered_farms:
    print(f"    {f['name']} -> Lat: {f['lat']}, Lon: {f['lon']}")

# ---------------------------------------------------------------

print("\n Step 2: Fetching empirical crop dataset from Open Agronomy Repository...")

VERIFIED_CROP_URL = "https://raw.githubusercontent.com/Gladiator07/Harvestify/master/Data-processed/crop_recommendation.csv"

crop_raw_df = pd.read_csv(VERIFIED_CROP_URL)

print(f" Successfully ingested {len(crop_raw_df)} real agronomic records via URL!")
print("Columns available:", list(crop_raw_df.columns))
print(crop_raw_df.head(5))

# --------------------------------------------------------

print("\n Step 3: Fusing discovered coordinates with NASA POWER & SoilGrids APIs...")

training_samples = []

for farm in discovered_farms:
    lat, lon = farm["lat"], farm["lon"]
    print(f"   Querying NASA & SoilGrids for: {farm['name']} ({lat}, {lon})...")
    
    nasa_url = (
        f"https://power.larc.nasa.gov/api/temporal/climatology/point"
        f"?parameters=T2M,PRECTOTCORR,GWETTOP"
        f"&community=AG&longitude={lon}&latitude={lat}&format=JSON"
    )
    nasa_res = requests.get(nasa_url, timeout=15).json()
    p = nasa_res["properties"]["parameter"]
    
    months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
    annual_rain = sum([p["PRECTOTCORR"][m] * 30 for m in months])
    avg_temp = sum([p["T2M"][m] for m in months]) / 12.0
    min_soil_wetness = min([p["GWETTOP"][m] for m in months])
    
    soil_url = (
        f"https://rest.isric.org/soilgrids/v2.0/properties/query"
        f"?lon={lon}&lat={lat}&property=clay&property=sand&property=soc"
        f"&depth=0-5cm&value=mean"
    )
    soil_res = requests.get(soil_url, timeout=12).json()
    layers = soil_res["properties"]["layers"]
    soil_props = {layer["name"]: layer["depths"][0]["values"]["mean"] for layer in layers}
    
    clay_pct = (soil_props.get("clay") or 250) / 10.0
    sand_pct = (soil_props.get("sand") or 400) / 10.0
    soc_g_kg = (soil_props.get("soc") or 150) / 10.0
    
    unique_crops = crop_raw_df.groupby('label').agg({
        'temperature': 'mean',
        'rainfall': 'mean',
        'ph': 'mean'
    }).reset_index()
    
    for _, crop in unique_crops.iterrows():
        temp_diff = abs(avg_temp - crop['temperature'])
        rain_diff = abs(annual_rain - crop['rainfall'])
        
        suitability = 100.0 - (temp_diff * 1.5) - (rain_diff * 0.04) + (soc_g_kg * 0.1)
        suitability = max(10.0, min(100.0, suitability))
        
        training_samples.append({
            "Crop": crop['label'],
            "Annual_Rain_mm": round(annual_rain, 1),
            "Avg_Temp": round(avg_temp, 1),
            "Min_Soil_Wetness": round(min_soil_wetness, 2),
            "Clay_Pct": round(clay_pct, 1),
            "Sand_Pct": round(sand_pct, 1),
            "Soil_Organic_Carbon": round(soc_g_kg, 1),
            "Optimal_pH": round(crop['ph'], 1),
            "Resilience_Score": round(suitability, 1)
        })
        
    time.sleep(1)

training_df = pd.DataFrame(training_samples)
print(f"\n Generated {len(training_df)} training rows completely from API responses!")
print(training_df.head(5))

# ---------------------------------------------------------------------

print("\n Step 4: Training FastAI Tabular Neural Network...")

dls = TabularDataLoaders.from_df(
    training_df,
    path=".",
    y_names="Resilience_Score",
    cat_names=["Crop"],
    cont_names=[
        "Annual_Rain_mm", "Avg_Temp", "Min_Soil_Wetness",
        "Clay_Pct", "Sand_Pct", "Soil_Organic_Carbon", "Optimal_pH"
    ],
    procs=[Categorify, Normalize],
    bs=16
)


learn = tabular_learner(dls, layers=[64, 32], metrics=rmse)
learn.fit_one_cycle(5, lr_max=1e-2)

learn.export("crop_model.pkl")
print("\n SUCCESS: fastai_crop_model.pkl exported without any errors!")